<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <OutputType>Exe</OutputType>
        <TargetFramework>net10.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <AssemblyName>ken</AssemblyName>

        <!-- <PublishAot>true</PublishAot>
        <IsTrimmable>true</IsTrimmable> -->

        <!-- 压缩一下大小，感觉使用的时候，差距不明显。。 -->
        <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Curl.CommandLine.Parser" Version="1.0.1" />
        <PackageReference Include="KubernetesClient" Version="19.0.2" />
        <PackageReference Include="Masuit.Tools.Core" Version="2026.2.2" />
        <PackageReference Include="NetEscapades.EnumGenerators" Version="1.0.0-beta21" />
        <PackageReference Include="Octokit" Version="14.0.0" />
        <PackageReference Include="Serilog" Version="4.4.0" />
        <PackageReference Include="Serilog.Sinks.Console" Version="6.1.1" />
        <PackageReference Include="Spectre.Console" Version="0.57.2" />
        <PackageReference Include="StackExchange.Redis" Version="3.1.31" />
        <PackageReference Include="System.CommandLine" Version="2.0.11" />
        <PackageReference Include="ThisAssembly" Version="2.1.5">
            <PrivateAssets>all</PrivateAssets>
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
        </PackageReference>
    </ItemGroup>

    <ItemGroup>
        <Folder Include="Properties\PublishProfiles\" />
    </ItemGroup>

    <ItemGroup>
        <FrameworkReference Include="Microsoft.AspNetCore.App" />
    </ItemGroup>

    <PropertyGroup>
        <!-- https://docs.microsoft.com/zh-cn/dotnet/core/project-sdk/msbuild-props#generateassemblyinfo -->
<!--        <GenerateAssemblyInfo>true</GenerateAssemblyInfo>-->
        <Version>2.1.4</Version>
<!--        <InformationalVersion>2.0.4</InformationalVersion>-->
    </PropertyGroup>

</Project>
